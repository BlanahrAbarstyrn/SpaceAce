config_version=5

[application]

config/name="SpaceAce"
run/main_scene="uid://b3kat2sxu5f6w"
config/features=PackedStringArray("4.6", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

SignalManager="*uid://beqhabemxrgx2"

[display]

window/size/viewport_width=1440
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="SpaceAce"

[global_group]

Collision="Can collide and deal damage to player without itself being destroyed"

